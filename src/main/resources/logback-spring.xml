<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Inherit Spring Boot's default console appender + pattern (incl. trace/span IDs) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
      OpenTelemetry Logback appender: bridges application logs into the OTel SDK.
      Spring Boot's OpenTelemetryLoggingAutoConfiguration provides the SdkLoggerProvider,
      and this appender feeds Logback events into it so they are exported via OTLP.
    -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>

